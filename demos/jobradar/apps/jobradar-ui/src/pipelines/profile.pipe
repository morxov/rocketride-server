{
	"components": [
		{
			"id": "webhook_1",
			"provider": "webhook",
			"name": "Resume upload",
			"config": {
				"hideForm": true,
				"mode": "Source",
				"parameters": {},
				"type": "webhook"
			},
			"ui": {
				"position": {
					"x": 20,
					"y": 200
				},
				"measured": {
					"width": 150,
					"height": 66
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "parse_1",
			"provider": "parse",
			"name": "Parse resume",
			"config": {},
			"input": [
				{
					"lane": "tags",
					"from": "webhook_1"
				}
			],
			"ui": {
				"position": {
					"x": 240,
					"y": 200
				},
				"measured": {
					"width": 150,
					"height": 66
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "response_text_1",
			"provider": "response_text",
			"name": "Resume text",
			"config": {
				"laneName": "text"
			},
			"input": [
				{
					"lane": "text",
					"from": "parse_1"
				}
			],
			"ui": {
				"position": {
					"x": 460,
					"y": 80
				},
				"measured": {
					"width": 150,
					"height": 66
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "question_1",
			"provider": "question",
			"config": {},
			"input": [
				{
					"lane": "text",
					"from": "parse_1"
				}
			],
			"ui": {
				"position": {
					"x": 460,
					"y": 200
				},
				"measured": {
					"width": 150,
					"height": 66
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "prompt_1",
			"provider": "prompt",
			"name": "Profile extractor",
			"config": {
				"instructions": [
					"The question is the plain text of a resume. Do not answer it. Return ONLY one JSON object, no code fences, no prose, with exactly these keys:",
					"{\"name\": string, \"headline\": one sentence about who they are, \"level\": one of \"intern\" or \"new_grad\" (intern if still a student graduating more than ~9 months from now, else new_grad), \"graduation\": string like \"May 2027\" or \"\", \"target_roles\": [2-5 short role titles they fit, e.g. \"software engineer\", \"machine learning engineer\", \"data scientist\"], \"skills\": [up to 25 short skill strings, most relevant first], \"locations\": [cities or regions they mention or live in, may be empty], \"evidence\": [up to 12 short factual resume lines (projects, jobs, results) quoted or lightly trimmed from the text]}",
					"Use only facts in the text. Never invent employers, degrees, skills or results."
				],
				"parameters": {}
			},
			"input": [
				{
					"lane": "questions",
					"from": "question_1"
				}
			],
			"ui": {
				"position": {
					"x": 680,
					"y": 200
				},
				"measured": {
					"width": 150,
					"height": 66
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "llm_gemini_1",
			"provider": "llm_gemini",
			"name": "Gemini",
			"config": {
				"profile": "custom",
				"model": "models/gemini-3.5-flash-lite",
				"apikey": "${ROCKETRIDE_GEMINI_KEY}",
				"modelTotalTokens": 1048576,
				"modelOutputTokens": 8192,
				"temperature": 0
			},
			"input": [
				{
					"lane": "questions",
					"from": "prompt_1"
				}
			],
			"ui": {
				"position": {
					"x": 900,
					"y": 200
				},
				"measured": {
					"width": 150,
					"height": 66
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "response_answers_1",
			"provider": "response_answers",
			"config": {
				"laneName": "answers"
			},
			"input": [
				{
					"lane": "answers",
					"from": "llm_gemini_1"
				}
			],
			"ui": {
				"position": {
					"x": 1120,
					"y": 200
				},
				"measured": {
					"width": 150,
					"height": 66
				},
				"nodeType": "default",
				"formDataValid": true
			}
		}
	],
